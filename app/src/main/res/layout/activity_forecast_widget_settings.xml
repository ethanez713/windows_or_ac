<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/CfgHeader">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Forecast widget settings"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/discard"
            style="@style/CfgDiscard"
            android:text="Discard changes" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView style="@style/CfgHint" android:text="These settings apply to THIS widget only — place another one for a different place or horizon." />

            <!-- The preview is the actual widget renderer at the real 4x2 size, not a
                 mock-up, so what it shows is what the home screen will show. -->
            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="186dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Preview of the forecast widget" />
            <TextView
                android:id="@+id/preview_empty"
                style="@style/CfgHint"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView style="@style/CfgLabel" android:text="Location" />
            <Spinner
                android:id="@+id/location"
                style="@style/CfgField"
                android:minHeight="48dp" />
            <TextView style="@style/CfgHint" android:text="Add, rename or reorder places in the app's settings under Locations." />

            <TextView style="@style/CfgLabel" android:text="How far ahead" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/hours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textSize="16sp"
                    android:hint="24" />
                <TextView
                    style="@style/CfgSub"
                    android:layout_marginStart="8dp"
                    android:text="hours" />
            </LinearLayout>
            <TextView android:id="@+id/hours_hint" style="@style/CfgHint" />

            <TextView style="@style/CfgLabel" android:text="Series" />
            <CheckBox android:id="@+id/show_temp" style="@style/CfgCheck" android:text="Temperature" />
            <CheckBox android:id="@+id/show_dew" style="@style/CfgCheck" android:text="Dew point" />
            <CheckBox android:id="@+id/show_rain" style="@style/CfgCheck" android:text="Rain" />
            <CheckBox android:id="@+id/show_aqi" style="@style/CfgCheck" android:text="Air quality (drawn along the bottom)" />
            <CheckBox android:id="@+id/show_score" style="@style/CfgCheck" android:text="Open-window score (colour strip along the bottom)" />
            <CheckBox android:id="@+id/show_uv" style="@style/CfgCheck" android:text="UV index (colour strip along the bottom)" />
            <CheckBox android:id="@+id/show_cloud" style="@style/CfgCheck" android:text="Cloud cover (halftone strip along the bottom)" />
            <CheckBox android:id="@+id/show_daynight" style="@style/CfgCheck" android:text="Day/night shading (midnight + noon lines)" />

            <TextView style="@style/CfgLabel" android:text="Theme" />
            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/theme_auto" style="@style/CfgCheck" android:text="Auto — follow the phone" />
                <RadioButton android:id="@+id/theme_light" style="@style/CfgCheck" android:text="Light" />
                <RadioButton android:id="@+id/theme_dark" style="@style/CfgCheck" android:text="Dark" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/hide_rain"
                style="@style/CfgCheck"
                android:layout_marginTop="8dp"
                android:text="Hide rain when unlikely (below 20%)" />
            <CheckBox
                android:id="@+id/tap_opens"
                style="@style/CfgCheck"
                android:text="Tap opens the app (off = refresh in place)" />

            <TextView style="@style/CfgLabel" android:text="Text size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <SeekBar
                    android:id="@+id/text_scale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="80"
                    android:max="200" />
                <TextView
                    android:id="@+id/text_scale_value"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:textSize="14sp"
                    android:text="130%" />
            </LinearLayout>
            <TextView style="@style/CfgHint" android:text="Scales every label the panel draws (80–200%)." />

            <TextView style="@style/CfgLabel" android:text="Background opacity" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <SeekBar
                    android:id="@+id/opacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="100" />
                <TextView
                    android:id="@+id/opacity_value"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:textSize="14sp"
                    android:text="100%" />
            </LinearLayout>
            <TextView style="@style/CfgHint" android:text="Below 100% the wallpaper shows through the card." />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/save"
        style="@style/CfgSave"
        android:text="Save" />
</LinearLayout>
