<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/CfgHeader">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Forecast widget settings"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/discard"
            style="@style/CfgDiscard"
            android:text="Discard changes" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView style="@style/CfgHint" android:text="Changes save on their own when you leave this screen. These settings apply to THIS widget only — place another one for a different horizon." />

            <!-- The preview is the actual widget renderer at the real 4x2 size, not a
                 mock-up, so what it shows is what the home screen will show. -->
            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="186dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitCenter"
                android:contentDescription="Preview of the forecast widget" />

            <TextView style="@style/CfgLabel" android:text="How far ahead" />
            <RadioGroup
                android:id="@+id/hours_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/hours_12" style="@style/CfgCheck" android:text="12 h" />
                <RadioButton android:id="@+id/hours_24" style="@style/CfgCheck" android:text="24 h" />
                <RadioButton android:id="@+id/hours_36" style="@style/CfgCheck" android:text="36 h" />
            </RadioGroup>
            <TextView style="@style/CfgHint" android:text="Always starts at the current hour." />

            <TextView style="@style/CfgLabel" android:text="Detail" />
            <RadioGroup
                android:id="@+id/detail_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/detail_compact" style="@style/CfgCheck" android:text="Compact — temperature and rain only" />
                <RadioButton android:id="@+id/detail_standard" style="@style/CfgCheck" android:text="Standard — adds dew point and air quality" />
                <RadioButton android:id="@+id/detail_everything" style="@style/CfgCheck" android:text="Everything — adds day markers" />
            </RadioGroup>

            <TextView style="@style/CfgLabel" android:text="Theme" />
            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/theme_auto" style="@style/CfgCheck" android:text="Auto" />
                <RadioButton android:id="@+id/theme_light" style="@style/CfgCheck" android:text="Light" />
                <RadioButton android:id="@+id/theme_dark" style="@style/CfgCheck" android:text="Dark" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/hide_rain"
                style="@style/CfgCheck"
                android:layout_marginTop="8dp"
                android:text="Hide rain when unlikely (below 20%)" />
            <CheckBox
                android:id="@+id/tap_opens"
                style="@style/CfgCheck"
                android:text="Tap opens the app (off = refresh in place)" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
