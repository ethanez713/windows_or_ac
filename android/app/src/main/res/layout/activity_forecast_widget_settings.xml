<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/CfgHeader">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Forecast widget settings"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/discard"
            style="@style/CfgDiscard"
            android:text="Discard changes" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView style="@style/CfgHint" android:text="These settings apply to THIS widget only — place another one for a different horizon." />

            <!-- The preview is the actual widget renderer at the real 4x2 size, not a
                 mock-up, so what it shows is what the home screen will show. -->
            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="186dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Preview of the forecast widget" />
            <TextView
                android:id="@+id/preview_empty"
                style="@style/CfgHint"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView style="@style/CfgLabel" android:text="How far ahead" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/hours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textSize="16sp"
                    android:hint="24" />
                <TextView
                    style="@style/CfgSub"
                    android:layout_marginStart="8dp"
                    android:text="hours" />
            </LinearLayout>
            <TextView android:id="@+id/hours_hint" style="@style/CfgHint" />

            <TextView style="@style/CfgLabel" android:text="Detail" />
            <RadioGroup
                android:id="@+id/detail_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/detail_compact" style="@style/CfgCheck" android:text="Compact — temperature and rain only" />
                <RadioButton android:id="@+id/detail_standard" style="@style/CfgCheck" android:text="Standard — adds dew point and air quality" />
                <RadioButton android:id="@+id/detail_everything" style="@style/CfgCheck" android:text="Everything — adds day markers" />
            </RadioGroup>

            <TextView style="@style/CfgLabel" android:text="Theme" />
            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/theme_auto" style="@style/CfgCheck" android:text="Auto — follow the phone" />
                <RadioButton android:id="@+id/theme_light" style="@style/CfgCheck" android:text="Light" />
                <RadioButton android:id="@+id/theme_dark" style="@style/CfgCheck" android:text="Dark" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/hide_rain"
                style="@style/CfgCheck"
                android:layout_marginTop="8dp"
                android:text="Hide rain when unlikely (below 20%)" />
            <CheckBox
                android:id="@+id/tap_opens"
                style="@style/CfgCheck"
                android:text="Tap opens the app (off = refresh in place)" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/save"
        style="@style/CfgSave"
        android:text="Save" />
</LinearLayout>
