<?xml version="1.0" encoding="utf-8"?>
<!-- Second home-screen widget: up to 3 chart panels stacked vertically, each a bitmap
     ImageView (RemoteViews can't draw vectors — see PanelGraph). The root's background
     colour is recoloured at runtime per the recommended action, same as widget_ac_windows.
     Panels beyond the configured count are hidden with View.GONE by the provider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/graphs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#2E7D32">

    <ImageView
        android:id="@+id/panel_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="Chart panel" />

    <ImageView
        android:id="@+id/panel_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="Chart panel" />

    <ImageView
        android:id="@+id/panel_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="Chart panel" />

    <!-- What time the shown data is FROM; see GraphsWidgetProvider.footerLabel. -->
    <TextView
        android:id="@+id/graphs_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="end"
        android:text="" />

</LinearLayout>
