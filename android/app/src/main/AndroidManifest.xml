<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Re-arm the widget's 10-minute auto-refresh alarm after a reboot (alarms don't
         survive one). No exact-alarm permission is needed: the tick is inexact. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, and only ever used to fill in the forecast coordinates: either once,
         or continuously if the user ticks "Use my phone's location". FINE is requested so
         the hyperlocal sources are pinned to the right address, with COARSE alongside so
         Android 12+ offers the Precise/Approximate choice and an Approximate grant still
         works. The app is fully usable with neither: enter a lat/long or an address.
         Location never leaves the device except as a weather-provider query parameter. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- The full app: Now / 14-Day forecast + score breakdown (Jetpack Compose). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget. No launcher Activity is needed: you add the
             widget from the launcher's widget tray. -->
        <receiver
            android:name=".AcWindowsProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.acwindows.ACTION_REFRESH" />
                <!-- The 10-minute self-rescheduling auto-refresh alarm. -->
                <action android:name="com.acwindows.ACTION_TICK" />
                <!-- Alarms are dropped on reboot / package replace: re-arm the tick. -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ac_windows_info" />
        </receiver>

        <!-- Global app / comfort settings (thresholds + location). Launched from the
             app's gear icon. Not the widget's configure screen anymore. -->
        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:label="AC / Windows settings"
            android:theme="@android:style/Theme.Material" />

        <!-- Widget-only settings (forecast length + opacity). Shown when the widget is
             added / reconfigured, and via long-press on the app's gear icon. -->
        <activity
            android:name=".WidgetSettingsActivity"
            android:exported="true"
            android:label="Widget settings"
            android:theme="@android:style/Theme.Material">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The graphs widget: the app's charts, per-panel switchable between a
             timeseries chart and an hourly list. Shares AcWindowsProvider's 10-minute
             alarm tick rather than owning one of its own. -->
        <receiver
            android:name=".GraphsWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.acwindows.ACTION_GRAPHS_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/graphs_widget_info" />
        </receiver>

        <!-- The forecast screen: the forecast widget's companion. A separate screen from
             MainActivity on purpose — that one answers "when do I open the windows", this
             one answers "what will conditions be". -->
        <activity
            android:name=".ForecastActivity"
            android:exported="false"
            android:label="Forecast" />

        <!-- The forecast widget: what the weather will do in the next N hours, as one
             layered panel. Shares AcWindowsProvider's 10-minute alarm tick and the same
             cached snapshot rather than owning either. -->
        <receiver
            android:name=".ForecastWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.acwindows.ACTION_FORECAST_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/forecast_widget_info" />
        </receiver>

        <!-- Forecast widget's per-instance settings (horizon, detail, theme). Keyed by
             widget id — see ForecastWidgetConfig. -->
        <activity
            android:name=".ForecastWidgetSettingsActivity"
            android:exported="true"
            android:label="Forecast widget settings"
            android:theme="@android:style/Theme.Material">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Graphs widget's per-instance settings (panels shown, timeseries/hourly per
             panel, look-ahead hours). Keyed by widget id — see GraphsWidgetConfig. -->
        <activity
            android:name=".GraphsWidgetSettingsActivity"
            android:exported="true"
            android:label="Graphs widget settings"
            android:theme="@android:style/Theme.Material">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
